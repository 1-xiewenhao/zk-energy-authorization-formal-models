theory IOTJ_Protocol_V2_E2E_Interface_Composition
begin

builtins: hashing, signing
functions: eventid/4, orderhash/11

restriction Distinct_Observer_Signers:
  "All x #i. NotEqual(x,x)@i ==> F"

/*
  Finite interface-composition model. The detailed cryptographic and state
  invariants are discharged in auth-binding, freshness-replay, relay-quorum,
  and settlement-binding. This model checks that their implementation-aligned
  interfaces compose in the required order. It deliberately removes public
  network term construction to avoid re-proving the four module internals.
  provider is repeated in the payee position, matching the Solidity v2 schema.
*/

rule Register_Payer_Order:
  let eventId = eventid(~sys,~session,~ctx,~nullifier)
      orderHash = orderhash(~sys,eventId,~ctx,~payer,~provider,~token,
                            ~provider,~amount,~rate,~policyVersion,~expiry)
  in
  [ Fr(~sys), Fr(~session), Fr(~ctx), Fr(~nullifier), Fr(~payer),
    Fr(~provider), Fr(~token), Fr(~amount), Fr(~rate),
    Fr(~policyVersion), Fr(~expiry), Fr(~provenance), Fr(~epoch),
    Fr(~observerSk1), Fr(~observerSk2), Fr(~observerSk3) ]
  --[ PayerIntentRegistered(~sys,orderHash,eventId,~ctx,~session,~nullifier,
                            ~payer,~provider,~token,~provider,~amount,~rate,
                            ~policyVersion,~expiry) ]->
  [ PendingAuthorization(~sys,orderHash,eventId,~ctx,~session,~nullifier,
                         ~payer,~provider,~token,~provider,~amount,~rate,
                         ~policyVersion,~expiry,~provenance),
    !RegisteredOrder(~sys,orderHash,eventId,~ctx,~session,~nullifier,
                     ~payer,~provider,~token,~provider,~amount,~rate,
                     ~policyVersion,~expiry),
    Unsettled(~sys,eventId,~ctx),
    !Observer(~sys,~epoch,pk(~observerSk1)),
    !Observer(~sys,~epoch,pk(~observerSk2)),
    !Observer(~sys,~epoch,pk(~observerSk3)) ]

rule Finalize_Authorization:
  [ PendingAuthorization(sys,orderHash,eventId,ctx,session,nullifier,
                         payer,provider,token,payee,amount,rate,
                         policyVersion,expiry,provenance) ]
  --[ AuthorizationAccepted(sys,orderHash,eventId,ctx,session,nullifier,
                            payer,provider,token,payee,amount,rate,
                            policyVersion,expiry),
      AuthorizationFinalized(sys,orderHash,eventId,ctx,provenance) ]->
  [ !FinalizedAuthorization(sys,orderHash,eventId,ctx,provenance) ]

rule Corrupt_Observer:
  [ !Observer(sys,epoch,observer) ]
  --[ ObserverCorrupted(sys,epoch,observer) ]->
  [ !CorruptedObserver(sys,epoch,observer) ]

rule Honest_Observer_Certificate:
  [ !FinalizedAuthorization(sys,orderHash,eventId,ctx,provenance),
    !Observer(sys,epoch,observer) ]
  --[ HonestCertificateIssued(sys,orderHash,eventId,ctx,epoch,provenance,
                              observer) ]->
  [ ObserverCertificate(sys,orderHash,eventId,ctx,epoch,provenance,observer) ]

rule Forged_Certificate_After_Corruption:
  [ !CorruptedObserver(sys,epoch,observer),
    !RegisteredOrder(sys,orderHash,eventId,ctx,session,nullifier,payer,
                     provider,token,payee,amount,rate,policyVersion,expiry) ]
  --[ ForgedCertificateIssued(sys,orderHash,eventId,ctx,epoch,observer) ]->
  [ ObserverCertificate(sys,orderHash,eventId,ctx,epoch,'forged',observer) ]

rule Collect_First_Certificate:
  [ ObserverCertificate(sys,orderHash,eventId,ctx,epoch,provenance,observer) ]
  -->
  [ OneCertificate(sys,orderHash,eventId,ctx,epoch,provenance,observer) ]

rule Collect_Second_Distinct_Certificate:
  [ OneCertificate(sys,orderHash,eventId,ctx,epoch,provenanceA,observerA),
    ObserverCertificate(sys,orderHash,eventId,ctx,epoch,provenanceB,observerB) ]
  --[ NotEqual(observerA,observerB),
      QuorumFormed(sys,orderHash,eventId,ctx,epoch,observerA,observerB) ]->
  [ QuorumReady(sys,orderHash,eventId,ctx,epoch,observerA,observerB) ]

rule Settle_Payment:
  [ QuorumReady(sys,orderHash,eventId,ctx,epoch,observerA,observerB),
    !RegisteredOrder(sys,orderHash,eventId,ctx,session,nullifier,payer,
                     provider,token,payee,amount,rate,policyVersion,expiry),
    Unsettled(sys,eventId,ctx) ]
  --[ SettlementAccepted(sys,orderHash,eventId,ctx,session,nullifier,payer,
                         provider,token,payee,amount,rate,policyVersion,expiry,
                         epoch,observerA,observerB) ]->
  [ Settled(sys,eventId,ctx) ]

lemma executable_end_to_end:
  exists-trace
  "Ex sys orderHash eventId ctx session nullifier payer provider token payee
      amount rate policyVersion expiry epoch observerA observerB #i.
     SettlementAccepted(sys,orderHash,eventId,ctx,session,nullifier,payer,
                        provider,token,payee,amount,rate,policyVersion,expiry,
                        epoch,observerA,observerB)@i"

lemma settlement_corresponds_to_exact_authorization:
  "All sys orderHash eventId ctx session nullifier payer provider token payee
       amount rate policyVersion expiry epoch observerA observerB #i.
     SettlementAccepted(sys,orderHash,eventId,ctx,session,nullifier,payer,
                        provider,token,payee,amount,rate,policyVersion,expiry,
                        epoch,observerA,observerB)@i
     & not (Ex #c1 #c2.
              ObserverCorrupted(sys,epoch,observerA)@c1
              & ObserverCorrupted(sys,epoch,observerB)@c2
              & #c1 < #i & #c2 < #i)
     ==> (Ex #a.
            AuthorizationAccepted(sys,orderHash,eventId,ctx,session,nullifier,
                                  payer,provider,token,payee,amount,rate,
                                  policyVersion,expiry)@a & #a < #i)"

lemma settlement_corresponds_to_prior_finalization:
  "All sys orderHash eventId ctx session nullifier payer provider token payee
       amount rate policyVersion expiry epoch observerA observerB #i.
     SettlementAccepted(sys,orderHash,eventId,ctx,session,nullifier,payer,
                        provider,token,payee,amount,rate,policyVersion,expiry,
                        epoch,observerA,observerB)@i
     & not (Ex #c1 #c2.
              ObserverCorrupted(sys,epoch,observerA)@c1
              & ObserverCorrupted(sys,epoch,observerB)@c2
              & #c1 < #i & #c2 < #i)
     ==> (Ex provenance #f.
            AuthorizationFinalized(sys,orderHash,eventId,ctx,provenance)@f
            & #f < #i)"

lemma settlement_has_registered_payment_context:
  "All sys orderHash eventId ctx session nullifier payer provider token payee
       amount rate policyVersion expiry epoch observerA observerB #i.
     SettlementAccepted(sys,orderHash,eventId,ctx,session,nullifier,payer,
                        provider,token,payee,amount,rate,policyVersion,expiry,
                        epoch,observerA,observerB)@i
     ==> (Ex #r.
            PayerIntentRegistered(sys,orderHash,eventId,ctx,session,nullifier,
                                  payer,provider,token,payee,amount,rate,
                                  policyVersion,expiry)@r & #r < #i)"

lemma settlement_has_distinct_quorum:
  "All sys orderHash eventId ctx session nullifier payer provider token payee
       amount rate policyVersion expiry epoch observerA observerB #i.
     SettlementAccepted(sys,orderHash,eventId,ctx,session,nullifier,payer,
                        provider,token,payee,amount,rate,policyVersion,expiry,
                        epoch,observerA,observerB)@i
     ==> not (observerA = observerB)"

lemma event_settled_at_most_once:
  "All sys order1 order2 eventId ctx1 ctx2 session1 session2 null1 null2
       payer1 payer2 provider1 provider2 token1 token2 payee1 payee2
       amount1 amount2 rate1 rate2 pv1 pv2 expiry1 expiry2 epoch1 epoch2
       a1 a2 b1 b2 #i #j.
     SettlementAccepted(sys,order1,eventId,ctx1,session1,null1,payer1,
                        provider1,token1,payee1,amount1,rate1,pv1,expiry1,
                        epoch1,a1,a2)@i
     & SettlementAccepted(sys,order2,eventId,ctx2,session2,null2,payer2,
                         provider2,token2,payee2,amount2,rate2,pv2,expiry2,
                         epoch2,b1,b2)@j
     ==> #i = #j"

lemma context_settled_at_most_once:
  "All sys order1 order2 event1 event2 ctx session1 session2 null1 null2
       payer1 payer2 provider1 provider2 token1 token2 payee1 payee2
       amount1 amount2 rate1 rate2 pv1 pv2 expiry1 expiry2 epoch1 epoch2
       a1 a2 b1 b2 #i #j.
     SettlementAccepted(sys,order1,event1,ctx,session1,null1,payer1,
                        provider1,token1,payee1,amount1,rate1,pv1,expiry1,
                        epoch1,a1,a2)@i
     & SettlementAccepted(sys,order2,event2,ctx,session2,null2,payer2,
                         provider2,token2,payee2,amount2,rate2,pv2,expiry2,
                         epoch2,b1,b2)@j
     ==> #i = #j"

end
